// The vocabulary an sbx-dev policy is written against.
//
// Generated from the embedded sbx command catalog. Do not edit: run
// "task policy:schema" to regenerate it after the catalog changes.
//
// One part of the request cannot be expressed here. context.flagValues holds the
// value of each flag a command was given, keyed by flag name, and Cedar records
// have fixed attributes — the keys depend on which command ran, so the record
// cannot be typed. Policies may still read it; only this schema is silent about
// it.

namespace SBX {
    // A named group a sandbox belongs to. Membership comes from the policy map,
    // which assigns groups to sandbox names and patterns.
    entity Group;

    // The calling sandbox, and the sandbox a command acts on.
    entity Sandbox in [Group] {
        // The sandbox's name, for patterns: principal.name like "worker-*".
        name: String,
    };

    // The resource for a command that acts on the host rather than on one
    // sandbox, such as "sbx ls" or "sbx daemon status".
    entity Host;

    // What the server parsed out of the command line.
    type Invocation = {
        // The full command path, so "policy allow network".
        command: String,
        // The names of the flags the command was given.
        flags: Set<String>,
        // Every host path the command names, made absolute against the
        // server's working directory and cleaned, so ".." cannot walk out of a
        // confined tree.
        hostPaths: Set<String>,
        // The deepest directory containing all of hostPaths. Cedar cannot test
        // every member of a set, so confinement is expressed against this: it
        // lies under a prefix exactly when all the paths do.
        hostPathsRoot: String,
        // Whether every host path lies under the directory sbx-dev runs in.
        // True when the command names no host path. This is the portable form
        // of confinement, for a policy that should not name a site's
        // directory.
        hostPathsUnderWorkdir: Bool,
        // Paths inside a sandbox, from the "sandbox:/path" form sbx cp
        // accepts.
        sandboxPaths: Set<String>,
        // Every sandbox the command names.
        sandboxes: Set<String>,
        // Image-like references the command names.
        references: Set<String>,
        // Network destinations the command names.
        network: Set<String>,
        // Whether the command names at least one sandbox and every sandbox it
        // names is the caller. Naming a sibling alongside itself is not
        // "itself".
        targetsSelf: Bool,
        // Whether the command names no sandbox and so acts on the host.
        targetsHost: Bool,
        // Whether the command carries arguments for another program, as "sbx
        // exec" does. Their content is opaque, so a policy can refuse them but
        // not inspect them.
        forwardsArguments: Bool,
    };

    // Capability groups. A policy grants one of these rather than a list of
    // command names, so it keeps meaning what it meant as sbx grows.
    action "read";
    action "inspectSecrets";
    action "createSandbox";
    action "destroySandbox";
    action "changeSandbox";
    action "runInSandbox";
    action "touchHostFiles";
    action "writePolicy";
    action "writeSecrets";
    action "controlDaemon";
    action "publishArtifacts";

    // Every command sbx offers. A command in no group can only be granted by
    // name, which is why a policy written in groups cannot reach a new one by
    // accident.
    action "completion" appliesTo {
        principal: [Sandbox],
        resource: [Sandbox, Host],
        context: Invocation
    };
    action "completion bash" appliesTo {
        principal: [Sandbox],
        resource: [Sandbox, Host],
        context: Invocation
    };
    action "completion fish" appliesTo {
        principal: [Sandbox],
        resource: [Sandbox, Host],
        context: Invocation
    };
